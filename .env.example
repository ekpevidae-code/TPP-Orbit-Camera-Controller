# Backend API (run server.js on a persistent Node.js host)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/velocity_run?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
CORS_ORIGIN="https://YOUR-FRONTEND-DOMAIN.vercel.app"
PORT=4000

# Vite frontend build environment (set on Vercel)
VITE_API_URL="https://YOUR-BACKEND-API-DOMAIN"
